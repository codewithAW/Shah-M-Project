VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-Side Only Credentials
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Drive API Configuration (Service Account - Legacy/Fallback)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"

# Google Drive API Configuration (OAuth 2.0 - Required for personal folder uploads)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/drive/auth/callback
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
